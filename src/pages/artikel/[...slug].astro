---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import { fullArticles, getArticle } from "../../data/articlesFull";
import { articlesEn } from "../../data/articlesEn";
import { catEn } from "../../i18n/cats";

export function getStaticPaths() {
  return fullArticles.map((a) => ({ params: { slug: a.slug } }));
}

const { slug } = Astro.params;
const artikel = getArticle(slug ?? "");
if (!artikel) {
  return Astro.redirect("/artikel");
}

const en = articlesEn[artikel.slug];
const idx = fullArticles.findIndex((a) => a.slug === artikel.slug);
const prev = idx > 0 ? fullArticles[idx - 1] : undefined;
const next = idx < fullArticles.length - 1 ? fullArticles[idx + 1] : undefined;
const related = fullArticles.filter((a) => a.slug !== artikel.slug).slice(0, 2);
const pageUrl = "https://nurturamom.com/artikel/" + artikel.slug;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  headline: artikel.title,
  description: artikel.excerpt,
  image: "https://nurturamom.com" + artikel.image,
  datePublished: artikel.dateISO,
  dateModified: "2026-09-27",
  author: { "@type": "Organization", name: "NurturaMom" },
  reviewedBy: { "@type": "Person", name: "Bidan NurturaMom", jobTitle: "Bidan" },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: artikel.faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---
<BaseLayout
  title={artikel.title + ": NurturaMom"}
  description={artikel.excerpt}
  path={"/artikel/" + artikel.slug}
  image={artikel.image}
  crumbLabel={artikel.title}
  articlePublished={artikel.dateISO}
  articleModified="2026-09-27"
  articleSection={artikel.category}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <div id="nm-progress" aria-hidden="true"></div>

  <article class="container-nm pt-8">
    <nav class="flex flex-wrap items-center gap-1.5 text-xs text-[#8A7A7E]" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#9C3D5C]" data-i18n="kal.bc">Beranda</a>
      <span aria-hidden="true">/</span>
      <a href="/artikel" class="hover:text-[#9C3D5C]" data-i18n="nav.art">Artikel</a>
      <span aria-hidden="true">/</span>
      <span class="font-semibold text-[#3D2B30]" data-en={catEn[artikel.category] ?? artikel.category}>{artikel.category}</span>
    </nav>

    <div class="mt-4 flex flex-wrap items-center gap-3 text-[11px]">
      <a href={artikel.categoryHref} class="rounded-full bg-[#EFD0D6] px-3 py-1 font-bold uppercase tracking-wide text-[#58293A]" data-en={catEn[artikel.category] ?? artikel.category}>{artikel.category}</a>
      <span class="inline-flex items-center gap-1 text-[#8A7A7E]">
        <Icon name="lucide:clock-3" class="h-3.5 w-3.5" />
        {artikel.minutes} <span data-i18n="arts.min">menit baca</span>
      </span>
      <span class="text-[#8A7A7E]" data-tanggal={artikel.dateISO}>{artikel.date}</span>
    </div>

    <h1 class="mt-3 max-w-[780px] text-[clamp(1.7rem,4vw,2.5rem)] font-extrabold leading-[1.15] tracking-tight text-[#58293A]" data-en={artikel.titleEn}>
      {artikel.title}
    </h1>
    <p class="mt-2 max-w-[640px] text-[15px] leading-relaxed text-[#3D2B30]/75" data-en={artikel.excerptEn}>{artikel.excerpt}</p>

    <div class="mt-4 flex flex-wrap items-center gap-2 no-print">
      <span class="text-xs font-bold text-[#8A7A7E]" data-i18n="art.share">Bagikan:</span>
      <a
        href={"https://wa.me/?text=" + encodeURIComponent(artikel.title + " " + pageUrl)}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-1.5 rounded-full border border-[#F3E6DD] bg-white px-3.5 py-1.5 text-xs font-semibold transition hover:border-[#7C9D8B]"
      >
        <Icon name="lucide:send" class="h-3.5 w-3.5 text-[#4A6B5B]" />
        WhatsApp
      </a>
      <button
        type="button"
        id="nm-copy"
        data-url={pageUrl}
        class="inline-flex items-center gap-1.5 rounded-full border border-[#F3E6DD] bg-white px-3.5 py-1.5 text-xs font-semibold transition hover:border-[#9C3D5C]"
      >
        <Icon name="lucide:clipboard-check" class="h-3.5 w-3.5 text-[#9C3D5C]" />
        <span id="nm-copy-label" data-i18n="art.copy">Salin tautan</span>
      </button>
    </div>

    <img
      src={artikel.image}
      alt={artikel.alt}
      class="mt-6 aspect-[16/9] w-full rounded-[20px] border border-[#F3E6DD] object-cover shadow-[0_16px_40px_rgba(88,41,58,0.08)]"
      loading="eager"
      fetchpriority="high"
    />

    <div class="mt-8 grid gap-8 lg:grid-cols-[1fr_300px]">
      <div>
        <div class="rounded-2xl border border-[#DCE9E1] bg-[#F2F7F3] p-4 sm:p-5">
          <p class="flex items-center gap-2 text-sm font-extrabold text-[#2F3A34]">
            <Icon name="lucide:clipboard-check" class="h-4 w-4 text-[#4A6B5B]" />
            <span data-i18n="art.points">Poin penting</span>
          </p>
          <ul class="mt-2.5 space-y-2">
            {
              artikel.takeaways.map((tw, i) => (
                <li class="flex gap-2.5 text-sm leading-relaxed text-[#2F3A34]">
                  <Icon name="lucide:check" class="mt-0.5 h-4 w-4 shrink-0 text-[#4A6B5B]" />
                  <span data-en={en?.takeaways[i] ?? tw}>{tw}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="mt-6 rounded-2xl border border-[#F3E6DD] bg-[#FFFCF8] p-4 no-print">
          <p class="text-xs font-bold uppercase tracking-wide text-[#8A7A7E]" data-i18n="art.toc">Isi artikel</p>
          <ol class="mt-2 space-y-1.5">
            {
              artikel.sections.map((s, i) => (
                <li>
                  <a href={"#bagian-" + (i + 1)} class="text-[13.5px] font-medium text-[#3D2B30] hover:text-[#9C3D5C]">
                    {i + 1}. <span data-en={en?.sections[i]?.h ?? s.h}>{s.h}</span>
                  </a>
                </li>
              ))
            }
          </ol>
        </div>

        {
          artikel.sections.map((s, i) => (
            <section class="mb-7 mt-7 scroll-mt-24" id={"bagian-" + (i + 1)}>
              <h2 class="flex items-baseline gap-2.5 text-[19px] font-extrabold tracking-tight text-[#2F2A2E]">
                <span class="grid h-7 w-7 shrink-0 translate-y-1 place-items-center rounded-full bg-[#EFD0D6]/50 text-[13px] text-[#76304A]">{i + 1}</span>
                <span data-en={en?.sections[i]?.h ?? s.h}>{s.h}</span>
              </h2>
              {s.p.map((t, j) => (
                <p class="mt-2.5 text-[15px] leading-[1.85] text-[#3D2B30]/85" data-en={en?.sections[i]?.p[j] ?? t}>{t}</p>
              ))}
            </section>
          ))
        }

        <div class="rounded-2xl bg-[#EFD0D6]/25 p-4 sm:p-5">
          <p class="flex items-center gap-2 text-sm font-bold text-[#76304A]">
            <Icon name="lucide:triangle-alert" class="h-4 w-4" />
            <span data-i18n="art.dangerH">Kapan harus ke bidan</span>
          </p>
          <p class="mt-1.5 text-sm leading-relaxed text-[#3D2B30]/80" data-en={en?.danger ?? artikel.danger}>{artikel.danger}</p>
          <p class="mt-3 text-[13px] font-semibold text-[#76304A]" data-i18n="art.faskes">Segera ke faskes terdekat bila tanda di atas muncul.</p>
        </div>

        <div class="mt-5 flex items-center gap-3 rounded-2xl border border-[#F3E6DD] bg-white p-4 sm:p-5">
          <img src="/logo.jpg" alt="Tim NurturaMom" class="h-12 w-12 shrink-0 rounded-full object-cover ring-1 ring-[#F3E6DD]" loading="lazy" />
          <div>
            <p class="text-[13px] font-bold text-[#2F2A2E]">Tim NurturaMom</p>
            <p class="text-xs text-[#8A7A7E]"><span data-i18n="art.written">Ditulis</span> <span data-tanggal={artikel.dateISO}>{artikel.date}</span></p>
          </div>
        </div>

        <div class="mt-6">
          <p class="text-[15px] font-extrabold text-[#58293A]" data-i18n="art.faqH">Pertanyaan umum</p>
          <div class="mt-2.5 space-y-2">
            {
              artikel.faqs.map((f, i) => (
                <details class="faq-nm">
                  <summary data-en={en?.faqs[i]?.q ?? f.q}>{f.q}</summary>
                  <p data-en={en?.faqs[i]?.a ?? f.a}>{f.a}</p>
                </details>
              ))
            }
          </div>
        </div>

        <nav class="mt-8 grid gap-3 sm:grid-cols-2" aria-label="Artikel sebelum dan sesudah">
          {
            prev ? (
              <a href={"/artikel/" + prev.slug} class="card-soft block p-4 transition hover:-translate-y-0.5">
                <p class="text-[11px] font-bold uppercase tracking-wide text-[#8A7A7E]" data-i18n="art.prev">Sebelumnya</p>
                <p class="mt-1 text-[13.5px] font-bold leading-snug text-[#2F2A2E]" data-en={prev.titleEn}>{prev.title}</p>
              </a>
            ) : (
              <span />
            )
          }
          {
            next ? (
              <a href={"/artikel/" + next.slug} class="card-soft block p-4 text-right transition hover:-translate-y-0.5">
                <p class="text-[11px] font-bold uppercase tracking-wide text-[#8A7A7E]" data-i18n="art.next">Berikutnya</p>
                <p class="mt-1 text-[13.5px] font-bold leading-snug text-[#2F2A2E]" data-en={next.titleEn}>{next.title}</p>
              </a>
            ) : (
              <span />
            )
          }
        </nav>
      </div>

      <aside class="space-y-4 lg:sticky lg:top-24 lg:self-start">
        <div class="card-soft p-5">
          <p class="text-sm font-bold text-[#58293A]" data-i18n="art.rel">Artikel terkait</p>
          <div class="mt-3 space-y-2.5">
            {
              related.map((r) => (
                <a href={"/artikel/" + r.slug} class="block rounded-xl border border-[#F3E6DD] p-3 transition hover:-translate-y-0.5 hover:border-[#9C3D5C]">
                  <p class="text-[10.5px] font-bold uppercase tracking-wide text-[#9C3D5C]" data-en={catEn[r.category] ?? r.category}>{r.category}</p>
                  <p class="mt-1 text-[13px] font-bold leading-snug text-[#2F2A2E]" data-en={r.titleEn}>{r.title}</p>
                </a>
              ))
            }
          </div>
        </div>
        <a href="/tools" class="block rounded-2xl bg-[#DCE9E1] p-5 transition hover:-translate-y-0.5">
          <p class="text-sm font-bold text-[#2F3A34]" data-i18n="art.ctaT">Butuh alat bantu?</p>
          <p class="mt-1 text-[13px] text-[#2F3A34]/70" data-i18n="art.ctaS">Hitung HPL, ceklis tas, dan jadwal imunisasi. Gratis.</p>
          <span class="mt-3 inline-flex items-center gap-2 rounded-full bg-[#4A6B5B] px-4 py-2 text-xs font-semibold text-white">
            <span data-i18n="art.ctaB">Buka tools</span>
            <Icon name="lucide:arrow-right" class="h-3.5 w-3.5" />
          </span>
        </a>
      </aside>
    </div>
  </article>

  <script>
    const bar = document.getElementById("nm-progress");
    const onScroll = () => {
      if (!bar) return;
      const h = document.documentElement;
      const max = h.scrollHeight - h.clientHeight;
      bar.style.width = (max > 0 ? (h.scrollTop / max) * 100 : 0) + "%";
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();

    const getDict2 = () => {
      try {
        return JSON.parse(document.getElementById("nm-dict")?.textContent || "{}");
      } catch {
        return {};
      }
    };
    const getLang2 = () => {
      try {
        return localStorage.getItem("nm-lang") === "en" ? "en" : "id";
      } catch {
        return "id";
      }
    };
    const copyBtn = document.getElementById("nm-copy");
    copyBtn?.addEventListener("click", () => {
      const url = copyBtn.getAttribute("data-url") ?? window.location.href;
      const label = document.getElementById("nm-copy-label");
      const dict = getDict2()[getLang2()] ?? {};
      if (navigator.clipboard) {
        navigator.clipboard.writeText(url).then(() => {
          if (label) label.textContent = dict["art.copied"] ?? "Tautan disalin";
          setTimeout(() => {
            if (label) label.textContent = dict["art.copy"] ?? "Salin tautan";
          }, 2000);
        });
      }
    });
    window.addEventListener("nm-lang", () => {
      const label = document.getElementById("nm-copy-label");
      const dict = getDict2()[getLang2()] ?? {};
      if (label && !navigator.clipboard) label.textContent = dict["art.copy"] ?? "Salin tautan";
    });
  </script>
</BaseLayout>
