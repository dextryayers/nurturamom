---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import { fullArticles, getArticle } from "../../data/articlesFull";
import { articlesEn } from "../../data/articlesEn";
import { toSourceLinks } from "../../data/sourceLinks";
import { catEn } from "../../i18n/cats";

export function getStaticPaths() {
  return fullArticles.map((a) => ({ params: { slug: a.slug } }));
}

const { slug } = Astro.params;
const artikel = getArticle(slug ?? "");
if (!artikel) {
  return Astro.redirect("/artikel");
}

const en = articlesEn[artikel.slug];
const idx = fullArticles.findIndex((a) => a.slug === artikel.slug);
const prev = idx > 0 ? fullArticles[idx - 1] : undefined;
const next = idx < fullArticles.length - 1 ? fullArticles[idx + 1] : undefined;
const related = [
  ...fullArticles.filter((a) => a.slug !== artikel.slug && a.category === artikel.category),
  ...fullArticles.filter((a) => a.slug !== artikel.slug && a.category !== artikel.category),
].slice(0, 3);
const sources = toSourceLinks(artikel.sumber);
const pageUrl = "https://nurturamom.com/artikel/" + artikel.slug;
const REVIEWED_ISO = "2026-11-23";
const REVIEWED_DATE = "23 November 2026";

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  headline: artikel.title,
  description: artikel.excerpt,
  image: "https://nurturamom.com" + artikel.image,
  datePublished: artikel.dateISO,
  dateModified: REVIEWED_ISO,
  lastReviewed: REVIEWED_ISO,
  medicalSpecialty: { "@type": "MedicalSpecialty", name: "Women's Health" },
  author: { "@type": "Person", name: "Bidan NurturaMom, S.Tr.Keb., Bd", jobTitle: "Bidan", affiliation: { "@type": "Organization", name: "NurturaMom" } },
  publisher: { "@type": "Organization", name: "NurturaMom", url: "https://nurturamom.com" },
  reviewedBy: {
    "@type": "Person",
    name: "Bidan NurturaMom, S.Tr.Keb., Bd",
    jobTitle: "Bidan",
    affiliation: { "@type": "Organization", name: "NurturaMom" },
  },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: artikel.faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---
<BaseLayout
  title={artikel.title + ": NurturaMom"}
  description={artikel.excerpt}
  path={"/artikel/" + artikel.slug}
  image={artikel.image}
  crumbLabel={artikel.title}
  articlePublished={artikel.dateISO}
  articleModified={REVIEWED_ISO}
  articleSection={artikel.category}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <div id="nm-progress" aria-hidden="true"></div>

  <article class="container-nm pt-8">
    <nav class="flex flex-wrap items-center gap-1.5 text-xs text-muted" aria-label="Breadcrumb">
      <a href="/" class="hover:text-raspberry" data-i18n="kal.bc">Beranda</a>
      <span aria-hidden="true">/</span>
      <a href="/artikel" class="hover:text-raspberry" data-i18n="nav.art">Artikel</a>
      <span aria-hidden="true">/</span>
      <span class="font-semibold text-ink" data-en={catEn[artikel.category] ?? artikel.category}>{artikel.category}</span>
    </nav>

    <div class="mt-4 flex flex-wrap items-center gap-3 text-[11px]">
      <a href={artikel.categoryHref} class="rounded-full bg-blush px-3 py-1 font-bold uppercase tracking-wide text-heading" data-en={catEn[artikel.category] ?? artikel.category}>{artikel.category}</a>
      <span class="inline-flex items-center gap-1 text-muted">
        <Icon name="lucide:clock-3" class="h-3.5 w-3.5" />
        {artikel.minutes} <span data-i18n="arts.min">menit baca</span>
      </span>
      <span class="text-muted" data-tanggal={artikel.dateISO}>{artikel.date}</span>
    </div>

    <h1 class="mt-3 max-w-[780px] text-[clamp(1.7rem,4vw,2.5rem)] font-extrabold leading-[1.15] tracking-tight text-heading" data-en={artikel.titleEn}>
      {artikel.title}
    </h1>
    <p class="mt-2 max-w-[640px] text-[15px] leading-relaxed text-ink/75" data-en={artikel.excerptEn}>{artikel.excerpt}</p>

    <div class="mt-5 flex flex-col gap-3 rounded-2xl border border-line bg-surface p-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-3">
        <img src="/logo.jpg" alt="Bidan NurturaMom" class="h-11 w-11 shrink-0 rounded-full object-cover ring-1 ring-line" loading="lazy" />
        <div>
          <p class="text-[11px] font-bold uppercase tracking-wide text-muted" data-i18n="art.reviewedBy">Ditinjau oleh</p>
          <p class="text-[13px] font-bold text-heading">Bidan NurturaMom, S.Tr.Keb., Bd</p>
          <p class="text-[11.5px] text-muted">
            <span data-i18n="art.reviewedOn">Terakhir ditinjau</span> {REVIEWED_DATE}
          </p>
        </div>
      </div>
      <a href="/tentang-bidan" class="link-more no-print shrink-0">
        <span data-i18n="art.seeProfile">Lihat profil bidan</span>
        <Icon name="lucide:arrow-right" class="h-3.5 w-3.5 text-raspberry" />
      </a>
    </div>

    <div class="mt-4 flex flex-wrap items-center gap-2 no-print">
      <span class="text-xs font-bold text-muted" data-i18n="art.share">Bagikan:</span>
      <a
        href={"https://wa.me/?text=" + encodeURIComponent(artikel.title + " " + pageUrl)}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-1.5 rounded-full border border-line bg-surface px-3.5 py-1.5 text-xs font-semibold transition hover:border-sage"
      >
        <Icon name="lucide:send" class="h-3.5 w-3.5 text-pine" />
        WhatsApp
      </a>
      <button
        type="button"
        id="nm-copy"
        data-url={pageUrl}
        class="inline-flex items-center gap-1.5 rounded-full border border-line bg-surface px-3.5 py-1.5 text-xs font-semibold transition hover:border-raspberry"
      >
        <Icon name="lucide:clipboard-check" class="h-3.5 w-3.5 text-raspberry" />
        <span id="nm-copy-label" data-i18n="art.copy">Salin tautan</span>
      </button>
    </div>

    <img
      src={artikel.image}
      alt={artikel.alt}
      class="mt-6 aspect-[16/9] w-full rounded-[20px] border border-line object-cover shadow-[0_16px_40px_rgba(88,41,58,0.08)]"
      loading="eager"
      fetchpriority="high"
    />

    <div class="mt-8 grid gap-8 lg:grid-cols-[1fr_300px]">
      <div>
        <div class="rounded-2xl border border-sagepale bg-sagepale/45 p-4 sm:p-5">
          <p class="flex items-center gap-2 text-sm font-extrabold text-forest">
            <Icon name="lucide:clipboard-check" class="h-4 w-4 text-pine" />
            <span data-i18n="art.points">Poin penting</span>
          </p>
          <ul class="mt-2.5 space-y-2">
            {
              artikel.takeaways.map((tw, i) => (
                <li class="flex gap-2.5 text-sm leading-relaxed text-forest">
                  <Icon name="lucide:check" class="mt-0.5 h-4 w-4 shrink-0 text-pine" />
                  <span data-en={en?.takeaways[i] ?? tw}>{tw}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="mt-6 rounded-2xl border border-line bg-paper p-4 no-print lg:hidden">
          <p class="text-xs font-bold uppercase tracking-wide text-muted" data-i18n="art.toc">Isi artikel</p>
          <ol class="mt-2 space-y-1.5">
            {
              artikel.sections.map((s, i) => (
                <li>
                  <a href={"#bagian-" + (i + 1)} class="text-[13.5px] font-medium text-ink hover:text-raspberry">
                    {i + 1}. <span data-en={en?.sections[i]?.h ?? s.h}>{s.h}</span>
                  </a>
                </li>
              ))
            }
          </ol>
        </div>

        {
          artikel.sections.map((s, i) => (
            <section class="mb-7 mt-7 scroll-mt-24" id={"bagian-" + (i + 1)} data-toc-section>
              <h2 class="flex items-baseline gap-2.5 text-[19px] font-extrabold tracking-tight text-heading">
                <span class="grid h-7 w-7 shrink-0 translate-y-1 place-items-center rounded-full bg-blush/50 text-[13px] text-berry">{i + 1}</span>
                <span data-en={en?.sections[i]?.h ?? s.h}>{s.h}</span>
              </h2>
              {s.p.map((t, j) => (
                <p class="mt-2.5 text-[15px] leading-[1.85] text-ink/85" data-en={en?.sections[i]?.p[j] ?? t}>{t}</p>
              ))}
            </section>
          ))
        }

        <div class="rounded-2xl bg-blush/25 p-4 sm:p-5">
          <p class="flex items-center gap-2 text-sm font-bold text-berry">
            <Icon name="lucide:triangle-alert" class="h-4 w-4" />
            <span data-i18n="art.dangerH">Kapan harus ke bidan</span>
          </p>
          <p class="mt-1.5 text-sm leading-relaxed text-ink/80" data-en={en?.danger ?? artikel.danger}>{artikel.danger}</p>
          <p class="mt-3 text-[13px] font-semibold text-berry" data-i18n="art.faskes">Segera ke faskes terdekat bila tanda di atas muncul.</p>
        </div>

        <div class="mt-6">
          <p class="text-[15px] font-extrabold text-heading" data-i18n="art.faqH">Pertanyaan umum</p>
          <div class="mt-2.5 space-y-2">
            {
              artikel.faqs.map((f, i) => (
                <details class="faq-nm">
                  <summary data-en={en?.faqs[i]?.q ?? f.q}>{f.q}</summary>
                  <p data-en={en?.faqs[i]?.a ?? f.a}>{f.a}</p>
                </details>
              ))
            }
          </div>
        </div>

        <section class="mt-7 rounded-2xl border border-line bg-paper p-5 sm:p-6" aria-labelledby="sumber-artikel">
          <h2 id="sumber-artikel" class="flex items-center gap-2 text-[16px] font-extrabold text-heading">
            <Icon name="lucide:book-open-check" class="h-4.5 w-4.5 text-pine" />
            <span data-i18n="art.sourcesH">Sumber dan rujukan</span>
          </h2>
          <ol class="mt-3 space-y-2.5">
            {
              sources.map((s, i) => (
                <li class="flex gap-2.5 text-[13px] leading-relaxed text-ink/80">
                  <span class="grid h-5 w-5 shrink-0 place-items-center rounded-full bg-sagepale text-[10px] font-bold text-forest">{i + 1}</span>
                  <a
                    href={s.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="underline decoration-line underline-offset-4 transition hover:text-raspberry hover:decoration-raspberry"
                  >
                    {s.label}
                    <Icon name="lucide:external-link" class="ml-1 inline h-3 w-3 text-raspberry" />
                  </a>
                </li>
              ))
            }
          </ol>
          <p class="mt-3 border-t border-line pt-3 text-[11px] leading-relaxed text-muted" data-i18n="art.sourcesNote">
            Tautan menuju halaman resmi penerbit. Diakses 23 November 2026.
          </p>
        </section>

        <div class="mt-5 rounded-2xl border border-line bg-surface p-4 sm:p-5">
          <div class="flex items-start gap-3">
            <img src="/logo.jpg" alt="Bidan NurturaMom" class="h-12 w-12 shrink-0 rounded-full object-cover ring-1 ring-line" loading="lazy" />
            <div>
              <p class="text-[13px] font-bold text-heading">Bidan NurturaMom, S.Tr.Keb., Bd</p>
              <p class="text-xs text-muted" data-i18n="art.reviewerRole">Bidan, S.Tr.Keb., Bd</p>
              <p class="mt-1 text-[11.5px] text-muted">
                <span data-i18n="art.reviewedOn">Terakhir ditinjau</span> {REVIEWED_DATE}
              </p>
            </div>
          </div>
          <p class="mt-3 text-[12px] leading-relaxed text-muted" data-i18n="art.reviewNote">
            Konten edukatif, bukan pengganti pemeriksaan langsung.
          </p>
          <a href="/tentang-bidan" class="link-more mt-2 no-print">
            <span data-i18n="art.seeProfile">Lihat profil bidan</span>
            <Icon name="lucide:arrow-right" class="h-3.5 w-3.5 text-raspberry" />
          </a>
        </div>

        <nav class="mt-8 grid gap-3 sm:grid-cols-2" aria-label="Artikel sebelum dan sesudah">
          {
            prev ? (
              <a href={"/artikel/" + prev.slug} class="card-soft block p-4 transition hover:-translate-y-0.5">
                <p class="text-[11px] font-bold uppercase tracking-wide text-muted" data-i18n="art.prev">Sebelumnya</p>
                <p class="mt-1 text-[13.5px] font-bold leading-snug text-heading" data-en={prev.titleEn}>{prev.title}</p>
              </a>
            ) : (
              <span />
            )
          }
          {
            next ? (
              <a href={"/artikel/" + next.slug} class="card-soft block p-4 text-right transition hover:-translate-y-0.5">
                <p class="text-[11px] font-bold uppercase tracking-wide text-muted" data-i18n="art.next">Berikutnya</p>
                <p class="mt-1 text-[13.5px] font-bold leading-snug text-heading" data-en={next.titleEn}>{next.title}</p>
              </a>
            ) : (
              <span />
            )
          }
        </nav>
      </div>

      <aside class="space-y-4">
        <nav class="card-soft hidden p-5 no-print lg:sticky lg:top-24 lg:block" aria-label="Isi artikel">
          <p class="text-xs font-bold uppercase tracking-wide text-muted" data-i18n="art.toc">Isi artikel</p>
          <ol class="mt-3 space-y-2">
            {
              artikel.sections.map((s, i) => (
                <li>
                  <a
                    href={"#bagian-" + (i + 1)}
                    data-toc-link
                    class="block text-[12.5px] font-medium leading-snug text-ink transition hover:text-raspberry"
                  >
                    {i + 1}. <span data-en={en?.sections[i]?.h ?? s.h}>{s.h}</span>
                  </a>
                </li>
              ))
            }
          </ol>
          <div class="mt-4 border-t border-line pt-3">
            <p class="flex items-center gap-1.5 text-[11px] font-semibold text-pine">
              <Icon name="lucide:shield-check" class="h-3.5 w-3.5" />
              Ditinjau bidan {REVIEWED_DATE}
            </p>
          </div>
        </nav>

        <div class="card-soft p-5">
          <p class="text-sm font-bold text-heading" data-i18n="art.rel">Artikel terkait</p>
          <div class="mt-3 space-y-2.5">
            {
              related.map((r) => (
                <a href={"/artikel/" + r.slug} class="block rounded-xl border border-line p-3 transition hover:-translate-y-0.5 hover:border-raspberry">
                  <p class="text-[10.5px] font-bold uppercase tracking-wide text-raspberry" data-en={catEn[r.category] ?? r.category}>{r.category}</p>
                  <p class="mt-1 text-[13px] font-bold leading-snug text-heading" data-en={r.titleEn}>{r.title}</p>
                </a>
              ))
            }
          </div>
        </div>
        <a href="/tools" class="block rounded-2xl bg-sagepale p-5 transition hover:-translate-y-0.5">
          <p class="text-sm font-bold text-forest" data-i18n="art.ctaT">Butuh alat bantu?</p>
          <p class="mt-1 text-[13px] text-forest/70" data-i18n="art.ctaS">Hitung HPL, ceklis tas, dan jadwal imunisasi. Gratis.</p>
          <span class="mt-3 inline-flex items-center gap-2 rounded-full bg-pinesolid px-4 py-2 text-xs font-semibold text-white">
            <span data-i18n="art.ctaB">Buka tools</span>
            <Icon name="lucide:arrow-right" class="h-3.5 w-3.5" />
          </span>
        </a>
      </aside>
    </div>
  </article>

  <script>
    const bar = document.getElementById("nm-progress");
    const onScroll = () => {
      if (!bar) return;
      const h = document.documentElement;
      const max = h.scrollHeight - h.clientHeight;
      bar.style.width = (max > 0 ? (h.scrollTop / max) * 100 : 0) + "%";
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();

    const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"));
    const tocSections = Array.from(document.querySelectorAll<HTMLElement>("[data-toc-section]"));
    if (tocLinks.length && tocSections.length && "IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const id = "#" + entry.target.id;
            tocLinks.forEach((link) => {
              const active = link.getAttribute("href") === id;
              link.classList.toggle("text-raspberry", active);
              link.classList.toggle("font-bold", active);
            });
          });
        },
        { rootMargin: "-18% 0px -68% 0px", threshold: 0 }
      );
      tocSections.forEach((section) => observer.observe(section));
    }

    const getDict2 = () => {
      try {
        return JSON.parse(document.getElementById("nm-dict")?.textContent || "{}");
      } catch {
        return {};
      }
    };
    const getLang2 = () => {
      try {
        return localStorage.getItem("nm-lang") === "en" ? "en" : "id";
      } catch {
        return "id";
      }
    };
    const copyBtn = document.getElementById("nm-copy");
    copyBtn?.addEventListener("click", () => {
      const url = copyBtn.getAttribute("data-url") ?? window.location.href;
      const label = document.getElementById("nm-copy-label");
      const dict = getDict2()[getLang2()] ?? {};
      if (navigator.clipboard) {
        navigator.clipboard.writeText(url).then(() => {
          if (label) label.textContent = dict["art.copied"] ?? "Tautan disalin";
          setTimeout(() => {
            if (label) label.textContent = dict["art.copy"] ?? "Salin tautan";
          }, 2000);
        });
      }
    });
    window.addEventListener("nm-lang", () => {
      const label = document.getElementById("nm-copy-label");
      const dict = getDict2()[getLang2()] ?? {};
      if (label && !navigator.clipboard) label.textContent = dict["art.copy"] ?? "Salin tautan";
    });
  </script>
</BaseLayout>
