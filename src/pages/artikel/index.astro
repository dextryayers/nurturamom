---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import { fullArticles } from "../../data/articlesFull";
---
<BaseLayout
  title="Artikel Kesehatan Ibu dan Anak: NurturaMom"
  description="Kumpulan artikel kehamilan, persalinan, nifas, dan bayi yang ditinjau bidan."
  path="/artikel"
  image="/img/img.webp"
>
  <section class="container-nm pt-8" data-reveal>
    <nav class="text-xs text-[#8A7A7E]" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#B9375E]">Beranda</a>
      <span class="mx-1">/</span>
      <span class="text-[#3D2B30]">Artikel</span>
    </nav>
    <h1 class="mt-3 text-[clamp(1.8rem,4vw,2.6rem)] font-extrabold tracking-tight text-[#602437]">Artikel Terbaru</h1>
    <p class="mt-2 max-w-[600px] text-[15px] text-[#3D2B30]/75">Bahasa sederhana, rujukan jelas, dan bisa langsung dipraktikkan.</p>
  </section>

  <section class="container-nm mt-6 grid gap-4 md:grid-cols-3">
    {
      fullArticles.map((a) => (
        <a href={"/artikel/" + a.slug} class="card-soft group overflow-hidden transition hover:-translate-y-1">
          <span class="block aspect-[16/10] overflow-hidden bg-[#FFF4EC]">
            <img src={a.image} alt={a.alt} loading="lazy" class="h-full w-full object-cover transition group-hover:scale-[1.03]" />
          </span>
          <span class="block p-5">
            <span class="flex items-center gap-3 text-[11px]">
              <span class="rounded-full bg-[#FFCAD4] px-2.5 py-1 font-bold uppercase text-[#602437]">{a.category}</span>
              <span class="inline-flex items-center gap-1 text-[#8A7A7E]">
                <Icon name="lucide:clock-3" class="h-3.5 w-3.5" />
                {a.minutes} menit baca
              </span>
            </span>
            <span class="mt-3 block text-[15px] font-bold text-[#2F2A2E]">{a.title}</span>
            <span class="mt-1.5 block text-[13px] text-[#8A7A7E] line-clamp-2">{a.excerpt}</span>
          </span>
        </a>
      ))
    }
  </section>
</BaseLayout>
