---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import { bidan } from "../data/bidan";

const clinicSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalClinic",
  name: "NurturaMom",
  description: "Praktik bidan: ANC, persalinan, nifas, laktasi, KB, dan bayi.",
  email: "hello@nurturamom.id",
  address: { "@type": "PostalAddress", addressCountry: "ID", addressLocality: "Indonesia" },
  openingHours: ["Mo-Fr 09:00-15:00", "Sa 09:00-12:00"],
};
---
<BaseLayout
  title="Tentang Bidan NurturaMom: Profil dan Jadwal Praktik: NurturaMom"
  description="Kenali bidan di balik NurturaMom: pengalaman 8 tahun, layanan ANC sampai KB, dan jadwal praktik."
  path="/tentang-bidan"
  image="/img/img.webp"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(clinicSchema)} />
  </Fragment>

  <section class="container-nm pt-8" data-reveal>
    <nav class="text-xs text-[#8A7A7E]" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#B9375E]">Beranda</a>
      <span class="mx-1">/</span>
      <span class="text-[#3D2B30]">Tentang Bidan</span>
    </nav>
    <div class="mt-4 grid gap-6 md:grid-cols-[280px_1fr]">
      <img
        src="/img/img.webp"
        alt="Bidan NurturaMom saat konsultasi kehamilan"
        class="h-[320px] w-full rounded-[20px] border border-[#F3E6DD] object-cover"
        loading="eager"
      />
      <div>
        <h1 class="text-[clamp(1.8rem,4vw,2.5rem)] font-extrabold tracking-tight text-[#602437]">{bidan.nama}, {bidan.gelar}</h1>
        <p class="mt-1 text-sm text-[#8A7A7E]">{bidan.str}</p>
        <p class="mt-3 max-w-[560px] text-[15px] leading-relaxed text-[#3D2B30]/80">{bidan.pengalaman}. {bidan.filosofi}</p>
        <div class="mt-4 flex flex-wrap gap-2">
          <a href="/konsultasi" class="inline-flex items-center gap-2 rounded-full bg-[#7C9D8B] px-6 py-3 text-sm font-semibold text-white hover:bg-[#6B8C7A]">
            <Icon name="lucide:message-circle" class="h-4 w-4" />
            Tanya Bidan
          </a>
          <a href="/kalender-kehamilan" class="inline-flex items-center gap-2 rounded-full border border-[#F3E6DD] bg-white px-6 py-3 text-sm font-semibold hover:border-[#B9375E]">
            Cek Kalender Hamil
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="container-nm mt-8 grid gap-4 md:grid-cols-3" data-reveal>
    <div class="card-soft p-5">
      <p class="flex items-center gap-2 text-sm font-bold text-[#602437]"><Icon name="lucide:graduation-cap" class="h-4 w-4 text-[#B9375E]" /> Pendidikan dan pelatihan</p>
      <ul class="mt-3 space-y-2 text-[13px] text-[#3D2B30]/80">
        {bidan.pendidikan.map((p) => <li class="flex gap-2"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[#E05780]"></span>{p}</li>)}
      </ul>
    </div>
    <div class="card-soft p-5">
      <p class="flex items-center gap-2 text-sm font-bold text-[#602437]"><Icon name="lucide:stethoscope" class="h-4 w-4 text-[#B9375E]" /> Layanan</p>
      <ul class="mt-3 space-y-2 text-[13px] text-[#3D2B30]/80">
        {bidan.layanan.map((p) => <li class="flex gap-2"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[#7C9D8B]"></span>{p}</li>)}
      </ul>
    </div>
    <div class="card-soft p-5">
      <p class="flex items-center gap-2 text-sm font-bold text-[#602437]"><Icon name="lucide:clock-3" class="h-4 w-4 text-[#B9375E]" /> Jadwal praktik</p>
      <ul class="mt-3 space-y-2 text-[13px] text-[#3D2B30]/80">
        {bidan.jadwal.map((j) => <li><span class="font-bold">{j.hari}.</span> {j.jam}. {j.tempat}.</li>)}
      </ul>
    </div>
  </section>

  <section class="container-nm mt-8" data-reveal>
    <h2 class="text-lg font-extrabold text-[#2F2A2E]">Cerita ibu yang didampingi</h2>
    <div class="mt-4 grid gap-4 md:grid-cols-3">
      <div class="card-soft p-5"><p class="text-sm leading-relaxed text-[#3D2B30]/80">Kontrol tiap 2 minggu di trimester 3 bikin tenang. Semua dijelaskan pelan pelan.</p><p class="mt-3 text-xs font-bold text-[#602437]">R, ibu 2 anak</p></div>
      <div class="card-soft p-5"><p class="text-sm leading-relaxed text-[#3D2B30]/80">Persalinan pertama saya didampingi penuh. Teknik napasnya sangat membantu.</p><p class="mt-3 text-xs font-bold text-[#602437]">S, ibu baru</p></div>
      <div class="card-soft p-5"><p class="text-sm leading-relaxed text-[#3D2B30]/80">Laktasi seret hari ke 3. Dibantu pijat dan posisi menyusui sampai lancar.</p><p class="mt-3 text-xs font-bold text-[#602437]">A, ibu menyusui</p></div>
    </div>
  </section>
  <section class="container-nm mt-10" data-reveal>
    <h2 class="text-lg font-extrabold text-[#2F2A2E]">Pertanyaan umum</h2>
    <div class="mt-4 grid gap-2.5 md:grid-cols-2">
      <details class="faq-nm">
        <summary>Apakah konsultasi pertama gratis?</summary>
        <p>Ya. Ceritakan keluhan singkat via WhatsApp. Bila perlu pemeriksaan langsung, bidan akan menjadwalkan kunjungan.</p>
      </details>
      <details class="faq-nm">
        <summary>Bisakah USG di praktik?</summary>
        <p>Jadwal USG mengikuti ketersediaan alat dan tenaga. Tanya dulu via konsultasi agar tidak bolak balik.</p>
      </details>
      <details class="faq-nm">
        <summary>Apakah melayani persalinan di rumah?</summary>
        <p>Pendampingan menyesuaikan kondisi ibu dan janin. Keamanan ibu dan bayi selalu jadi prioritas utama.</p>
      </details>
      <details class="faq-nm">
        <summary>Bagaimana bila darurat di luar jam praktik?</summary>
        <p>Hubungi nomor darurat yang diberikan saat kontrol. Bila tidak tersambung dan ada tanda bahaya, langsung ke IGD terdekat.</p>
      </details>
    </div>
  </section>
</BaseLayout>
