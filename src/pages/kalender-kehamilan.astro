---
import BaseLayout from "../layouts/BaseLayout.astro";
import PregnancyCalendar from "../components/PregnancyCalendar.vue";
import ToolFooter from "../components/ToolFooter.astro";
import { Icon } from "astro-icon/components";

const hpht = Astro.url.searchParams.get("hpht") ?? undefined;
const siklusRaw = Astro.url.searchParams.get("siklus");
const siklusNum = siklusRaw ? Math.min(45, Math.max(21, parseInt(siklusRaw, 10) || 28)) : undefined;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Bagaimana cara menghitung HPL dari HPHT?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Tambah 7 hari, kurang 3 bulan, tambah 1 tahun dari HPHT. Contoh HPHT 10 Maret 2026 menghasilkan HPL 17 Desember 2026. Konfirmasi dengan USG trimester 1.",
      },
    },
    {
      "@type": "Question",
      name: "Apakah hasil kalender ini pengganti USG?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Bukan. Kalender ini alat bantu edukasi. Usia pasti dan kondisi janin tetap perlu pemeriksaan bidan atau dokter.",
      },
    },
  ],
};
---
<BaseLayout
  title="Kalender Kehamilan dan Kalkulator HPL: NurturaMom"
  description="Hitung usia kehamilan dan HPL dari HPHT. Pantau perkembangan janin tiap minggu plus checklist gizi dan tanda bahaya."
  path="/kalender-kehamilan"
  image="/img/img.webp"
  hideFooter
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <section class="container-nm pt-8" data-reveal>
    <nav class="text-xs text-[#8A7A7E]" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#9C3D5C]" data-i18n="kal.bc">Beranda</a>
      <span class="mx-1">/</span>
      <span class="text-[#3D2B30]" data-i18n="kal.title">Kalender Kehamilan</span>
    </nav>
    <h1 class="mt-3 text-[clamp(1.8rem,4vw,2.6rem)] font-extrabold tracking-tight text-[#58293A]" data-i18n="kal.title">
      Kalender Kehamilan
    </h1>
    <p class="mt-2 max-w-[620px] text-[15px] leading-relaxed text-[#3D2B30]/75" data-i18n="kal.sub">
      Masukkan HPHT untuk tahu usia kehamilan, trimester, HPL, dan ukuran janin minggu ini. Gratis dan bisa dibagikan.
    </p>
  </section>

  <section class="container-nm mt-6">
    <PregnancyCalendar client:load initialHpht={hpht} initialSiklus={siklusNum} />
  </section>

  <section class="container-nm mt-8 grid gap-4 md:grid-cols-3" data-reveal>
    <div class="card-soft p-5">
      <Icon name="lucide:calendar-clock" class="h-6 w-6 text-[#9C3D5C]" />
      <h2 class="mt-2 text-sm font-bold text-[#2F2A2E]" data-i18n="kal.b1t">Rumus Naegele</h2>
      <p class="mt-1 text-[13px] leading-relaxed text-[#8A7A7E]" data-i18n="kal.b1s">HPHT tambah 7 hari, kurang 3 bulan, tambah 1 tahun. Berlaku untuk siklus 28 hari.</p>
    </div>
    <div class="card-soft p-5">
      <Icon name="lucide:triangle-alert" class="h-6 w-6 text-[#9C3D5C]" />
      <h2 class="mt-2 text-sm font-bold text-[#2F2A2E]" data-i18n="kal.b2t">Kapan harus ke bidan</h2>
      <p class="mt-1 text-[13px] leading-relaxed text-[#8A7A7E]" data-i18n="kal.b2s">Perdarahan, ketuban pecah, demam, nyeri hebat, atau gerak janin berkurang. Jangan tunggu.</p>
    </div>
    <div class="card-soft p-5">
      <Icon name="lucide:clipboard-check" class="h-6 w-6 text-[#9C3D5C]" />
      <h2 class="mt-2 text-sm font-bold text-[#2F2A2E]" data-i18n="kal.b3t">Jadwal ANC</h2>
      <p class="mt-1 text-[13px] leading-relaxed text-[#8A7A7E]" data-i18n="kal.b3s">Minimal 6 kali: 1 kali trimester 1, 2 kali trimester 2, 3 kali trimester 3.</p>
    </div>
  </section>
  <ToolFooter current="/kalender-kehamilan" />
</BaseLayout>
