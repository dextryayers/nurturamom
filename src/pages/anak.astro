---
import PilarLayout from "../layouts/PilarLayout.astro";
---
<PilarLayout
  title="Kesehatan Anak 0-5 Tahun: MPASI dan Imunisasi: NurturaMom"
  description="Panduan anak: MPASI, imunisasi lanjutan, stimulasi, dan tanda red flag tumbuh kembang."
  path="/anak"
  breadcrumb="Anak"
  headingEn="Child"
  descEn="Child guide: complementary feeding, follow up vaccines, stimulation, and growth red flags."
  chips={["MPASI", "Imunisasi", "Stunting", "Stimulasi", "Demam"]}
  chipsEn={["Solids", "Vaccines", "Stunting", "Stimulation", "Fever"]}
  danger="Segera periksa bila anak kejang, sesak, dehidrasi (tidak BAK 6 jam, bibir kering, mata cekung), demam di atas 39 derajat, atau berat badan turun 2 bulan berturut."
  dangerEn="Go promptly for seizures, breathing trouble, dehydration (no pee 6 hours, dry lips, sunken eyes), fever above 39 degrees, or weight loss 2 months straight."
  faqs={[
    { q: "Kapan mulai MPASI?", a: "Tepat 6 bulan. Tekstur saring kental lalu naik bertahap. Lanjut ASI sampai 2 tahun." },
    { q: "Bagaimana cegah stunting?", a: "ASI eksklusif, MPASI kaya protein hewani tiap hari, imunisasi lengkap, cuci tangan, dan timbang rutin di posyandu." },
    { q: "Kapan khawatir soal bicara?", a: "Red flag: 12 bulan belum babbling, 18 bulan belum ada kata bermakna, 24 bulan belum gabung 2 kata. Segera skrining." },
  ]}
  faqsEn={[
    { q: "When to start solids?", a: "Right at 6 months. Thick strained texture, step up gradually. Continue milk to age 2." },
    { q: "How to prevent stunting?", a: "Exclusive breastfeeding, daily animal protein solids, full vaccines, handwashing, routine posyandu weighing." },
    { q: "When to worry about speech?", a: "Red flags: no babbling at 12 months, no meaningful word at 18 months, no 2 word combos at 24 months. Screen promptly." },
  ]}
>
  <h2 class="text-lg font-extrabold text-[#2F2A2E]" data-en="Meal pattern by age">Pola makan per usia</h2>
  <ul class="mt-3 space-y-2 text-sm leading-relaxed text-[#3D2B30]/80">
    <li data-en="6-8 months. 2-3 meals plus milk. 3-5 spoons growing gradually. Daily animal protein."><span class="font-bold text-[#58293A]">6-8 bulan.</span> 2-3 kali makan plus ASI. Porsi 3-5 sendok naik bertahap. Protein hewani tiap hari.</li>
    <li data-en="9-11 months. 3-4 meals plus 1-2 snacks. Minced texture."><span class="font-bold text-[#58293A]">9-11 bulan.</span> 3-4 kali makan plus 1-2 selingan. Tekstur cincang halus.</li>
    <li data-en="12-23 months. Family meals 3 times plus 2 snacks. Limit sugar and sweet tea."><span class="font-bold text-[#58293A]">12-23 bulan.</span> Makan keluarga 3 kali plus 2 selingan. Batasi gula dan teh manis.</li>
  </ul>
</PilarLayout>
