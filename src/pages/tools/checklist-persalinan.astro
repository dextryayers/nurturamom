---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ChecklistPersalinan from "../../components/ChecklistPersalinan.vue";
import ToolFooter from "../../components/ToolFooter.astro";
---
<BaseLayout
  title="Checklist Persiapan Persalinan: NurturaMom"
  description="Daftar barang dan dokumen untuk persalinan. Centang tiap item dan pantau progress otomatis."
  path="/tools/checklist-persalinan"
  image="/img/img.webp"
  hideFooter
>
  <section class="container-nm pt-8" data-reveal>
    <nav class="text-xs text-muted" aria-label="Breadcrumb">
      <a href="/" class="hover:text-raspberry" data-i18n="chk.bc">Beranda</a>
      <span class="mx-1">/</span>
      <span class="text-ink" data-i18n="chk.title">Checklist Persiapan Persalinan</span>
    </nav>
    <h1 class="mt-3 text-[clamp(1.8rem,4vw,2.6rem)] font-extrabold tracking-tight text-heading" data-i18n="chk.title">Checklist Persiapan Persalinan</h1>
    <p class="mt-2 max-w-[600px] text-[15px] text-ink/75" data-i18n="chk.sub">Siapkan dari minggu 34. Data tersimpan otomatis di HP Anda.</p>
  </section>
  <section class="container-nm mt-6">
    <ChecklistPersalinan client:load />
  </section>
  <ToolFooter current="/tools/checklist-persalinan" />
</BaseLayout>
