---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HplCalculator from "../../components/HplCalculator.vue";
import ToolFooter from "../../components/ToolFooter.astro";
---
<BaseLayout
  title="Kalkulator HPL: Perkiraan Tanggal Persalinan: NurturaMom"
  description="Hitung HPL dari HPHT dengan rumus Naegele. Cepat, gratis, dan bisa dibagikan ke bidan."
  path="/tools/hpl"
  image="/img/img.webp"
>
  <section class="container-nm pt-8" data-reveal>
    <nav class="text-xs text-[#8A7A7E]" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#B9375E]">Beranda</a>
      <span class="mx-1">/</span>
      <a href="/kalender-kehamilan" class="hover:text-[#B9375E]">Tools</a>
      <span class="mx-1">/</span>
      <span class="text-[#3D2B30]">Kalkulator HPL</span>
    </nav>
    <h1 class="mt-3 text-[clamp(1.8rem,4vw,2.6rem)] font-extrabold tracking-tight text-[#602437]">Kalkulator HPL</h1>
    <p class="mt-2 max-w-[600px] text-[15px] text-[#3D2B30]/75">Masukkan HPHT. Hasil langsung tampil di bawah.</p>
  </section>
  <section class="container-nm mt-6">
    <HplCalculator client:load />
  </section>
  <ToolFooter current="/tools/hpl" />
</BaseLayout>
