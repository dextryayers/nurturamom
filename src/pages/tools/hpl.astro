---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HplCalculator from "../../components/HplCalculator.vue";
import ToolFooter from "../../components/ToolFooter.astro";
---
<BaseLayout
  title="Kalkulator HPL: Perkiraan Tanggal Persalinan: NurturaMom"
  description="Hitung HPL dari HPHT dengan rumus Naegele. Cepat, gratis, dan bisa dibagikan."
  path="/tools/hpl"
  image="/img/img.webp"
  hideFooter
>
  <section class="container-nm pt-8" data-reveal>
    <nav class="text-xs text-[#8A7A7E]" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#9C3D5C]" data-i18n="hpl.bc">Beranda</a>
      <span class="mx-1">/</span>
      <a href="/tools" class="hover:text-[#9C3D5C]" data-i18n="hpl.tools">Tools</a>
      <span class="mx-1">/</span>
      <span class="text-[#3D2B30]" data-i18n="hpl.title">Kalkulator HPL</span>
    </nav>
    <h1 class="mt-3 text-[clamp(1.8rem,4vw,2.6rem)] font-extrabold tracking-tight text-[#58293A]" data-i18n="hpl.title">Kalkulator HPL</h1>
    <p class="mt-2 max-w-[600px] text-[15px] text-[#3D2B30]/75" data-i18n="hpl.sub">Masukkan HPHT. Hasil langsung tampil di bawah.</p>
  </section>
  <section class="container-nm mt-6">
    <HplCalculator client:load />
  </section>
  <ToolFooter current="/tools/hpl" />
</BaseLayout>
