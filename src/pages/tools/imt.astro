---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BmiCalculator from "../../components/BmiCalculator.vue";
import ToolFooter from "../../components/ToolFooter.astro";
---
<BaseLayout
  title="Hitung IMT Ibu: Status Gizi: NurturaMom"
  description="Hitung indeks massa tubuh untuk memantau status gizi sebelum dan saat hamil."
  path="/tools/imt"
  image="/img/img.webp"
  hideFooter
>
  <section class="container-nm pt-8" data-reveal>
    <nav class="text-xs text-muted" aria-label="Breadcrumb">
      <a href="/" class="hover:text-raspberry" data-i18n="imt.bc">Beranda</a>
      <span class="mx-1">/</span>
      <span class="text-ink" data-i18n="imt.title">Hitung IMT</span>
    </nav>
    <h1 class="mt-3 text-[clamp(1.8rem,4vw,2.6rem)] font-extrabold tracking-tight text-heading" data-i18n="imt.title">Hitung IMT</h1>
    <p class="mt-2 max-w-[600px] text-[15px] text-ink/75" data-i18n="imt.sub">Pantau status gizi sebagai bekal kehamilan sehat.</p>
  </section>
  <section class="container-nm mt-6">
    <BmiCalculator client:load />
  </section>
  <ToolFooter current="/tools/imt" />
</BaseLayout>
