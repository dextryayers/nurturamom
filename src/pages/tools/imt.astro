---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BmiCalculator from "../../components/BmiCalculator.vue";
import ToolFooter from "../../components/ToolFooter.astro";
---
<BaseLayout
  title="Hitung IMT Ibu: Status Gizi: NurturaMom"
  description="Hitung indeks massa tubuh untuk memantau status gizi sebelum dan saat hamil."
  path="/tools/imt"
  image="/img/img.webp"
>
  <section class="container-nm pt-8" data-reveal>
    <nav class="text-xs text-[#8A7A7E]" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#B9375E]">Beranda</a>
      <span class="mx-1">/</span>
      <span class="text-[#3D2B30]">Hitung IMT</span>
    </nav>
    <h1 class="mt-3 text-[clamp(1.8rem,4vw,2.6rem)] font-extrabold tracking-tight text-[#602437]">Hitung IMT</h1>
    <p class="mt-2 max-w-[600px] text-[15px] text-[#3D2B30]/75">Pantau status gizi sebagai bekal kehamilan sehat.</p>
  </section>
  <section class="container-nm mt-6">
    <BmiCalculator client:load />
  </section>
  <ToolFooter current="/tools/imt" />
</BaseLayout>
