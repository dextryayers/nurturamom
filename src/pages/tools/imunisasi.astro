---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ImunisasiTable from "../../components/ImunisasiTable.vue";
import ToolFooter from "../../components/ToolFooter.astro";
---
<BaseLayout
  title="Jadwal Imunisasi Anak 0-18 Bulan: NurturaMom"
  description="Tabel imunisasi dasar anak 0 sampai 18 bulan sesuai pedoman IDAI plus catatan tiap kunjungan."
  path="/tools/imunisasi"
  image="/img/img.webp"
  hideFooter
>
  <section class="container-nm pt-8" data-reveal>
    <nav class="text-xs text-[#8A7A7E]" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#9C3D5C]" data-i18n="imu.bc">Beranda</a>
      <span class="mx-1">/</span>
      <span class="text-[#3D2B30]" data-i18n="imu.title">Jadwal Imunisasi</span>
    </nav>
    <h1 class="mt-3 text-[clamp(1.8rem,4vw,2.6rem)] font-extrabold tracking-tight text-[#58293A]" data-i18n="imu.title">Jadwal Imunisasi Anak</h1>
    <p class="mt-2 max-w-[600px] text-[15px] text-[#3D2B30]/75" data-i18n="imu.sub">Simpan halaman ini sebagai pengingat tiap bulan.</p>
  </section>
  <section class="container-nm mt-6">
    <ImunisasiTable client:load />
  </section>
  <ToolFooter current="/tools/imunisasi" />
</BaseLayout>
