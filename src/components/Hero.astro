---
import { Icon } from "astro-icon/components";
---
<section aria-label="Pengantar NurturaMom" data-reveal>
  <div class="relative flex min-h-[92svh] items-center overflow-hidden bg-[#FFF4EC] md:min-h-[86vh]">
    <img
      src="/img/img.webp"
      alt="Bidan berkonsultasi dengan ibu hamil"
      class="absolute inset-0 h-full w-full object-cover object-[70%_center]"
      loading="eager"
      fetchpriority="high"
    />
    <div
      class="absolute inset-0 bg-gradient-to-r from-[#FFFCF8] via-[#FFFCF8]/92 via-55% to-[#FFFCF8]/5"
      aria-hidden="true"
    ></div>
    <div
      class="absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-[#FFFCF8] to-transparent"
      aria-hidden="true"
    ></div>

    <div class="container-nm relative z-10 w-full py-16 md:py-20">
      <div class="max-w-[560px]">
        <h1 class="text-[clamp(2.6rem,6vw,4.2rem)] font-extrabold leading-[1.02] tracking-[-0.025em] text-[#5A6E64]">
          Teman Sehat
          <span class="relative mt-1 block w-fit text-[#C96A86]">
            Ibu dan Anak
            <svg class="absolute -bottom-2 left-0 w-full" viewBox="0 0 220 12" fill="none" aria-hidden="true" preserveAspectRatio="none">
              <path d="M4 8C60 2 160 2 216 7" stroke="#FFCAD4" stroke-width="5" stroke-linecap="round" />
            </svg>
          </span>
        </h1>
        <p class="mt-5 max-w-[440px] text-[15.5px] leading-relaxed text-[#3D2B30]/80">
          Informasi kesehatan terpercaya untuk menemani setiap tahap perjalanan menjadi ibu. Dari tes positif sampai anak usia 5 tahun.
        </p>

        <form
          action="/cari"
          method="get"
          role="search"
          class="mt-6 flex max-w-[480px] items-center gap-2 rounded-full bg-white p-2 pl-4 shadow-[0_16px_44px_rgba(96,36,55,0.16)] ring-1 ring-[#F3E6DD] transition focus-within:ring-2 focus-within:ring-[#B9375E]/40"
        >
          <Icon name="lucide:search" class="h-4 w-4 shrink-0 text-[#8A7A7E]" />
          <label for="q" class="sr-only">Cari informasi kesehatan</label>
          <input
            id="q"
            name="q"
            type="search"
            placeholder="Cari informasi kesehatan..."
            autocomplete="off"
            class="w-full bg-transparent text-sm text-[#3D2B30] placeholder:text-[#8A7A7E] focus:outline-none"
          />
          <button
            type="submit"
            class="shrink-0 rounded-full bg-[#7C9D8B] px-7 py-2.5 text-sm font-semibold text-white transition hover:bg-[#6B8C7A] active:scale-[0.98]"
          >
            Cari
          </button>
        </form>
        <div class="mt-3.5 flex flex-wrap items-center gap-2 text-xs text-[#3D2B30]/70">
          <span>Populer:</span>
          <a class="rounded-full border border-[#F3E6DD] bg-white/80 px-3 py-1 font-medium backdrop-blur hover:border-[#B9375E] hover:text-[#B9375E]" href="/kalender-kehamilan">HPL</a>
          <a class="rounded-full border border-[#F3E6DD] bg-white/80 px-3 py-1 font-medium backdrop-blur hover:border-[#B9375E] hover:text-[#B9375E]" href="/kehamilan">Trimester 2</a>
          <a class="rounded-full border border-[#F3E6DD] bg-white/80 px-3 py-1 font-medium backdrop-blur hover:border-[#B9375E] hover:text-[#B9375E]" href="/tools/imunisasi">Imunisasi BCG</a>
        </div>

        <dl class="mt-8 flex gap-6 border-t border-[#3D2B30]/10 pt-5">
          <div>
            <dt class="text-[11px] font-bold uppercase tracking-wide text-[#8A7A7E]">Artikel</dt>
            <dd class="text-xl font-extrabold text-[#602437]">120+</dd>
          </div>
          <div class="border-l border-[#3D2B30]/10 pl-6">
            <dt class="text-[11px] font-bold uppercase tracking-wide text-[#8A7A7E]">Tools</dt>
            <dd class="text-xl font-extrabold text-[#602437]">5 gratis</dd>
          </div>
          <div class="border-l border-[#3D2B30]/10 pl-6">
            <dt class="text-[11px] font-bold uppercase tracking-wide text-[#8A7A7E]">Review</dt>
            <dd class="text-xl font-extrabold text-[#602437]">Bidan</dd>
          </div>
        </dl>
      </div>
    </div>

    <div class="absolute bottom-6 right-6 z-10 hidden items-center gap-3 rounded-2xl bg-white/92 p-3.5 pr-5 shadow-xl backdrop-blur md:flex">
      <img src="/logo.jpg" alt="" class="h-11 w-11 rounded-full object-cover ring-1 ring-[#F3E6DD]" loading="lazy" />
      <div>
        <p class="text-[12.5px] font-bold text-[#2F2A2E]">Didampingi bidan berpengalaman</p>
        <p class="text-[11.5px] text-[#8A7A7E]">8 tahun ANC sampai laktasi</p>
      </div>
    </div>
  </div>
</section>
