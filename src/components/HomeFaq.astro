---
const faqs = [
  {
    q: "Bagaimana cara menghitung usia kehamilan?",
    a: "Usia kehamilan dihitung dari hari pertama haid terakhir (HPHT). Buka halaman Kalender Kehamilan, isi HPHT, hasil usia, trimester, dan HPL langsung tampil.",
  },
  {
    q: "Kapan harus ke bidan saat hamil?",
    a: "Segera periksa bila ada perdarahan, ketuban pecah, demam tinggi, nyeri hebat, atau gerak janin berkurang. Jangan menunggu jadwal kontrol.",
  },
  {
    q: "Apakah semua tools gratis?",
    a: "Ya. Kalender kehamilan, kalkulator HPL, hitung IMT, checklist persalinan, dan jadwal imunisasi bisa dipakai gratis tanpa daftar akun.",
  },
  {
    q: "Apakah artikel ditinjau tenaga kesehatan?",
    a: "Ya. Setiap artikel ditinjau bidan bersertifikat sebelum tayang. Nama peninjau dan tanggal tinjauan tercantum di tiap artikel.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---
<section class="container-nm section-nm" aria-label="Pertanyaan umum" data-reveal>
  <div class="grid gap-6 lg:grid-cols-[0.9fr_1.1fr]">
    <div>
      <p class="text-xs font-extrabold tracking-[0.2em] text-[#9C3D5C]/50">04</p>
      <h2 class="h2-nm mt-1" data-i18n="faq.title">Masih ada yang ingin ditanyakan?</h2>
      <p class="sub-nm" data-i18n="faq.sub">Jawaban cepat untuk hal yang paling sering ditanyakan ibu.</p>
      <a href="/tools" class="btn-sage mt-5 no-print" data-i18n="faq.cta">Lihat semua tools</a>
    </div>
    <div class="space-y-2.5">
      {
        faqs.map((f, i) => (
          <details class="faq-nm">
            <summary data-i18n={"faq.q" + (i + 1)}>{f.q}</summary>
            <p data-i18n={"faq.a" + (i + 1)}>{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>
