---
import { Icon } from "astro-icon/components";
import { latestArticles } from "../data/articlesFull";
import { catEn } from "../i18n/cats";

const cards = latestArticles(3);
---
<section class="container-nm mt-14" aria-label="Artikel terbaru" data-reveal>
  <div class="flex items-end justify-between gap-4">
    <div>
      <p class="text-xs font-extrabold tracking-[0.2em] text-[#9C3D5C]/50">02</p>
      <h2 class="h2-nm mt-1" data-i18n="arts.title">Artikel Terbaru</h2>
      <p class="sub-nm" data-i18n="arts.sub">Baca artikel pilihan untuk menambah wawasan dan menjaga kesehatan Anda dan si kecil.</p>
    </div>
    <a href="/artikel" class="link-more hidden shrink-0 whitespace-nowrap sm:inline-flex">
      <span data-i18n="arts.all">Lihat semua</span>
      <Icon name="lucide:arrow-right" class="h-3.5 w-3.5 text-[#9C3D5C]" />
    </a>
  </div>

  <div class="mt-6 grid gap-5 md:grid-cols-3">
    {
      cards.map((a, i) => (
        <a
          href={"/artikel/" + a.slug}
          class:list={[
            "card-soft group overflow-hidden transition duration-300 hover:-translate-y-1.5 hover:border-[#9C3D5C]/40 hover:shadow-[0_16px_40px_rgba(88,41,58,0.10)]",
            i === 0 ? "md:-rotate-[0.5deg]" : i === 2 ? "md:rotate-[0.5deg]" : "",
          ]}
        >
          <span class="relative block aspect-[16/10] overflow-hidden bg-[#FFF4EC]">
            <img src={a.image} alt={a.alt} loading="lazy" class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.05]" />
            <span class="absolute left-3 top-3 rounded-full bg-white/90 px-2.5 py-1 text-[11px] font-bold uppercase tracking-wide text-[#58293A] backdrop-blur" data-en={catEn[a.category] ?? a.category}>
              {a.category}
            </span>
          </span>
          <span class="block p-5">
            <span class="flex flex-wrap items-center gap-2 text-[11.5px] text-[#8A7A7E]">
              <Icon name="lucide:clock-3" class="h-3.5 w-3.5" />
              {a.minutes} <span data-i18n="arts.min">menit baca</span>
              <span aria-hidden="true">•</span>
              <span data-tanggal={a.dateISO}>{a.date}</span>
            </span>
            <span class="mt-2.5 block text-[15.5px] font-bold leading-snug text-[#2F2A2E] group-hover:text-[#76304A]" data-en={a.titleEn}>{a.title}</span>
            <span class="mt-1.5 block text-[13px] leading-relaxed text-[#8A7A7E] line-clamp-2" data-en={a.excerptEn}>{a.excerpt}</span>
            <span class="mt-3 inline-flex items-center gap-1.5 text-[13px] font-semibold text-[#9C3D5C]">
              <span data-i18n="arts.read">Baca artikel</span>
              <Icon name="lucide:arrow-right" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1" />
            </span>
          </span>
        </a>
      ))
    }
  </div>

  <a href="/artikel" class="link-more mt-4 sm:hidden">
    <span data-i18n="arts.all">Lihat semua</span>
    <Icon name="lucide:arrow-right" class="h-3.5 w-3.5 text-[#9C3D5C]" />
  </a>
</section>
