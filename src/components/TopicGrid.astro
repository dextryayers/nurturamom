---
import { Icon } from "astro-icon/components";
import { topics } from "../data/topics";
---
<section class="container-nm mt-14" aria-label="Jelajahi informasi kesehatan" data-reveal>
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h2 class="h2-nm">Jelajahi Informasi Kesehatan</h2>
      <p class="sub-nm">Pilih topik yang ingin Anda pelajari sesuai dengan tahap perjalanan Anda.</p>
    </div>
    <a href="/kalender-kehamilan" class="link-more">
      Mulai dari kalender
      <Icon name="lucide:arrow-right" class="h-3.5 w-3.5 text-[#B9375E]" />
    </a>
  </div>

  <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      topics.map((t, i) => (
        <a
          href={"/" + t.slug}
          class="card-soft group relative overflow-hidden p-6 transition duration-300 hover:-translate-y-1.5 hover:shadow-[0_16px_40px_rgba(96,36,55,0.10)]"
          style={`transition-delay:${Math.min(i, 5) * 40}ms`}
        >
          <span class="pointer-events-none absolute -right-10 -top-10 h-28 w-28 rounded-full bg-[#FFF4EC] transition group-hover:scale-125" aria-hidden="true" />
          <span class:list={["relative grid h-16 w-16 place-items-center rounded-2xl transition group-hover:scale-105", t.tint]}>
            <Icon name={t.icon} class="h-7 w-7" />
          </span>
          <h3 class="relative mt-4 text-[17px] font-bold text-[#2F2A2E] group-hover:text-[#8A2846]">{t.title}</h3>
          <p class="relative mt-1.5 min-h-[40px] text-[13px] leading-relaxed text-[#8A7A7E]">{t.desc}</p>
          <span class="relative mt-4 inline-flex items-center gap-1.5 text-[13px] font-semibold text-[#3D2B30]">
            Lihat selengkapnya
            <span class="grid h-6 w-6 place-items-center rounded-full bg-[#FFF4EC] transition group-hover:bg-[#B9375E] group-hover:text-white">
              <Icon name="lucide:arrow-right" class="h-3.5 w-3.5 text-[#B9375E] group-hover:text-white" />
            </span>
          </span>
        </a>
      ))
    }
  </div>
</section>
