---
import { Icon } from "astro-icon/components";
---
<section class="container-nm mt-14" aria-label="Ajakan mulai" data-reveal>
  <div class="relative overflow-hidden rounded-[24px] bg-[#DCE9E1] shadow-[0_20px_60px_rgba(74,107,91,0.18)]">
    <div
      class="pointer-events-none absolute -right-16 -top-16 h-64 w-64 rounded-full bg-white/30 blur-3xl"
      aria-hidden="true"
    ></div>
    <div class="relative grid items-center gap-6 p-6 sm:p-8 md:grid-cols-[240px_1fr_auto]">
      <div class="relative">
        <img
          src="/img/img.webp"
          alt="Ibu dan anak tersenyum bersama"
          loading="lazy"
          class="h-[150px] w-full -rotate-1 rounded-2xl border-4 border-white object-cover shadow-lg md:h-[160px] md:w-[240px]"
        />
        <span class="absolute -bottom-3 left-4 inline-flex items-center gap-1.5 rounded-full bg-white px-3 py-1.5 text-[11px] font-bold text-[#4A6B5B] shadow">
          <Icon name="lucide:heart-handshake" class="h-3.5 w-3.5" />
          8 tahun dampingi ibu
        </span>
      </div>
      <div class="pt-2 md:pt-0">
        <h2 data-i18n="cta.title" class="max-w-[420px] text-[22px] font-extrabold leading-snug tracking-tight text-[#2F3A34]">
          Mulai perjalanan sehat bersama nurturamom
        </h2>
        <p data-i18n="cta.sub" class="mt-1.5 max-w-[480px] text-sm leading-relaxed text-[#2F3A34]/70">
          Dapatkan informasi, tips, dan panduan kesehatan ibu dan anak dalam satu tempat. Ditinjau bidan.
        </p>
        <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-[12.5px] font-medium text-[#2F3A34]/80">
          <li class="inline-flex items-center gap-1.5"><Icon name="lucide:check" class="h-3.5 w-3.5 text-[#4A6B5B]" /> <span data-i18n="cta.li1">Kalender HPL</span></li>
          <li class="inline-flex items-center gap-1.5"><Icon name="lucide:check" class="h-3.5 w-3.5 text-[#4A6B5B]" /> <span data-i18n="cta.li2">Checklist tas</span></li>
          <li class="inline-flex items-center gap-1.5"><Icon name="lucide:check" class="h-3.5 w-3.5 text-[#4A6B5B]" /> <span data-i18n="cta.li3">Panduan tahap</span></li>
        </ul>
      </div>
      <div class="flex flex-col gap-2.5">
        <a
          href="/kalender-kehamilan"
          class="inline-flex items-center justify-center gap-2 rounded-full bg-[#2F3A34] px-7 py-3.5 text-sm font-semibold text-white shadow-lg transition hover:-translate-y-px hover:bg-[#1f2925]"
        >
          <span data-i18n="cta.btn">Jelajahi Sekarang</span>
          <Icon name="lucide:arrow-right" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </div>
</section>
